IP_KOMPUTERA=0.0.0.0

NES_COORDINATOR_IP=$IP_KOMPUTERA
NES_COORDINATOR_RPC_PORT=4000
NES_COORDINATOR_REST_PORT=8081

QUERY_HOST_IP=$IP_KOMPUTERA

MQTT_IP=$IP_KOMPUTERA
MQTT_PORT_LEADER=9001 # COMPARE WITH /config/leader/mosquitto.conf
MQTT_PORT_FOLLOWER=9002 # COMPARE WITH /config/follower/mosquitto.conf
MQTT_PORT_LEADER_INV=9003 # COMPARE WITH /config/leader_inv/mosquitto.conf
MQTT_PORT_RESULTS=9004 # COMPARE WITH /config/results/mosquitto.conf
MQTT_PORT_HUMIDITY=9005 # COMPARE WITH /config/humidity/mosquitto.conf

ROBOT_NAME_LEADER=leader
ROBOT_NAME_FOLLOWER=follower
ROBOT_NAME_LEADER_INV=leader_inv
ROS2_TOPIC_LEADER=/leader/gps/fix
ROS2_TOPIC_FOLLOWER=/follower/gps/fix
ROS2_TOPIC_LEADER_INV=/leader/gps/fix
MQTT_TOPIC_LEADER=leader_gps_fix
MQTT_TOPIC_FOLLOWER=follower_gps_fix
MQTT_TOPIC_LEADER_INV=leader_inv_gps_fix

ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

GEOFENCE_QUERY=query_1a
FIELD_FILE=1_MONT.txt

HUMIDITY_QUERY=query_2a
HUMIDITY_THRESHOLD=15
BUFFER_RADIUS=1000

QUERY_NAMES=query_1a;query_2a